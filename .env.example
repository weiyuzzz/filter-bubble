# Server酱 Turbo（SCT 开头）SendKey，从 https://sct.ftqq.com 获取
SERVERCHAN_SENDKEY=

# 日报简报里放几个项目（1–5，默认 3）
GITPULSE_PUSH_ITEMS=3

# 可选：提升 GitHub API 额度（60/h → 5000/h）
GITHUB_TOKEN=

# ---------- 全球热点雷达（独立模块，全部可选） ----------
# 雷达专用 SendKey；不填则回退使用上面的 SERVERCHAN_SENDKEY
RADAR_SERVERCHAN_SENDKEY=

# 雷达配置文件路径（默认项目根目录 social_radar.json）
# RADAR_CONFIG=

# 雷达总开关（默认启用；设为 0 可完全关闭雷达调度，不影响 GitHub 日报）
# RADAR_ENABLED=1

# 雷达每日生成时间（覆盖 social_radar.json → schedule.daily_time）
# RADAR_DAILY_TIME=09:00

# 雷达自动推送开关（默认关闭）
# RADAR_PUSH_ENABLED=0

# 启用雷达摘要的大模型后端后，API key 放这里（不要在 social_radar.json 里写密钥）
# 配合 social_radar.json → llm.enabled / provider / base_url / model 使用
# RADAR_LLM_API_KEY=

# 访问被重置的源（如 BBC 中文）时可设置本地代理，例如 http://127.0.0.1:12001
# HTTPS_PROXY=
