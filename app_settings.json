{
  "version": 1,
  "llm": {
    "enabled": true,
    "provider": "openai_compatible",
    "base_url": "https://openrouter.ai/api/v1",
    "model": "recursive/flint-v1.0:free",
    "api_key_env": "RADAR_LLM_API_KEY",
    "timeout_seconds": 60,
    "max_attempts": 2,
    "temperature": 0.2,
    "max_tokens": 1500,
    "note": "API Key 不写在这里：在网页「全局设置」里填，只存 data/ai_secrets.json；也可用环境变量 RADAR_LLM_API_KEY。",
    "fallback": {
      "enabled": false,
      "provider": "openai_compatible",
      "base_url": "",
      "model": "",
      "api_key_env": "RADAR_LLM_API_KEY_FALLBACK"
    }
  },
  "ai": {
    "enable_briefs": true,
    "briefs_per_run": 6,
    "concurrency": 1,
    "note": "briefs_per_run：每天自动为多少个 GitHub 项目生成 AI 解读；其余项目可在「项目速读」里按需生成。"
  }
}
