{
  "version": 1,
  "enabled": true,
  "timezone": "Asia/Shanghai",

  "schedule": {
    "daily_time": "09:00",
    "retry_after_minutes": 10,
    "max_retries": 3
  },

  "limits": {
    "max_candidates": 600,
    "max_events": 220,
    "max_report_events": 12,
    "source_timeout_seconds": 12,
    "source_retries": 1,
    "min_minutes_between_collects": 20,
    "min_minutes_between_reports": 60,
    "hotlist_top_n": 10,
    "news_top_n": 40
  },

  "cluster": {
    "within_run_threshold": 0.3,
    "match_threshold": 0.35,
    "story_threshold": 0.42
  },

  "backoff": {
    "degrade_after": 3,
    "degrade_interval_minutes": 60,
    "pause_after": 6
  },

  "newsnow": {
    "api_url": "https://newsnow.busiyi.world/api/s",
    "verify_domain": true,
    "note": "抖音/知乎/贴吧/华尔街见闻/财联社/澎湃/凤凰走这个第三方聚合 API；可在 sources 里单独关闭某个平台，例如 \"sources\": {\"douyin\": {\"enabled\": false}}"
  },

  "filters": {
    "noise_keywords": [
      "吃不吃挑战", "返厂了", "抽奖", "转发抽", "表情包", "壁纸",
      "cp向", "磕糖", "二创", "鬼畜", "整活", "梗图"
    ],
    "min_engagement": {
      "bilibili_popular": { "view": 50000 },
      "hackernews": { "points": 40 }
    }
  },

  "scoring": {
    "velocity": 0.3,
    "cross_platform": 0.2,
    "engagement": 0.2,
    "verification": 0.2,
    "interest": 0.1
  },

  "report": {
    "length": "standard",
    "top_events": 12,
    "section_limits": { "zh_web": 8, "intl": 8, "tech": 8, "investigations": 5 }
  },

  "push": {
    "enabled": false,
    "channel": "radar-wechat",
    "items": 5,
    "alert_threshold": 82,
    "max_attempts": 3,
    "fallback_to_main_key": true,
    "sendkey_env": "RADAR_SERVERCHAN_SENDKEY"
  },

  "interests": {
    "topics": [
      "AI 与大模型",
      "芯片与半导体",
      "开源软件",
      "国际科技公司",
      "游戏与消费电子",
      "国际新闻",
      "中国科技发展与科研成果",
      "产业竞争与经济事件"
    ],
    "keywords": [],
    "synonyms": {},
    "exclude": [],
    "languages": ["zh", "en"]
  },

  "investigation": {
    "min_heat": 70,
    "max_evidence": 60,
    "tech_auto_check": true,
    "tech_keywords": [
      "芯片", "半导体", "光刻", "大模型", "人工智能", "量子", "可控核聚变",
      "超导", "6G", "卫星", "航空发动机", "新材料", "量产", "首次实现",
      "国际领先", "突破"
    ]
  },

  "retention": { "days": 90 },

  "llm": {
    "enabled": false,
    "provider": "openai_compatible",
    "base_url": "",
    "model": "",
    "api_key_env": "RADAR_LLM_API_KEY",
    "timeout_seconds": 45,
    "max_attempts": 2,
    "max_events": 12,
    "temperature": 0.2,
    "note": "可在网页「监控设置 → 大模型」里配置；API Key 只存本地 data/radar_secrets.json。未配置时自动回退到本地抽取式摘要"
  },

  "sources": {}
}
